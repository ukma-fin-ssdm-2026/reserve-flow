# Скопіюйте в .env (він у .gitignore) і змініть пароль
POSTGRES_USER=reserveflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reserveflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Необов'язково: повний URL замість змінних вище
# DATABASE_URL=postgresql+psycopg://reserveflow:change-me@localhost:5432/reserveflow  # pragma: allowlist secret

# Необов'язково: тести за замовчуванням ганяються на SQLite in-memory.
# Для тестів на окремій PostgreSQL-базі:
# TEST_DATABASE_URL=postgresql+psycopg://reserveflow:change-me@localhost:5432/reserveflow_test  # pragma: allowlist secret
